# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
wheels/
*.egg-info/
.eggs/
.Python

# ── Virtual environments ──
.venv/
venv/
env/
ENV/

# ── Editors / IDE ──
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Claude Code / AI tooling ──
# Anchored at repo root only — sub-projects (e.g. reachy-mini-intent-runtime/)
# ship their own tracked .claude/agents/, hooks/, and settings.json that MUST
# remain version-controlled. Without the leading `/`, the rule would silently
# swallow them when sub-projects are added as tracked subdirectories.
/.claude/
/.cursor/

# ── Secrets & local config ──
.env
*.env.local
.env.*.local

# ── Models (users fetch via README instructions) ──
*.onnx
*.task
*.bin
*.pt
*.gguf
*.safetensors
models/

# ── Runtime artifacts ──
logs/
*.log
tts_cache/
conversation_log.jsonl
*.jsonl
!example_*.jsonl

# ── Temporary ──
tmp/
*.tmp
*.pid
*.sock

# ── User-specific dev notes ──
HANDOVER.md
SCRATCH.md
archive/

# ── Session scratch (file exchange with remote deploy host, NOT source) ──
_s1_edit/
_publish/
_publish.tar.gz
_pr_body.md
bash.exe.stackdump

# ── Separate public bench repo artefacts (see qwen3.6-specdec-rtx3090 repo) ──
bench/
bench_llm.py
bench_qwen36.py
bench_tts.py

# ── Runtime state written by robot-brain on the deploy host ──
conversation_summary.txt
conversation_summary.txt.watermark
.qdrant_memory/

# ── pytest + lint caches ──
.pytest_cache/
.ruff_cache/

# ─────────────────────────────────────────────────────────────────────────
# Local research artefacts — dev-box only, never pushed to public repo.
# Per `feedback_research_repo_scope`: scratch scripts, result JSONs, bench
# output dirs, PR/publication drafts all stay local. Root-anchored so
# sub-projects (e.g. reachy-mini-intent-runtime/) keep their own files.
# ─────────────────────────────────────────────────────────────────────────

# Underscore-prefixed scratch scripts and probes (Group B)
/_*.py
/_*.sh
/_*.json

# Scratch directories at root (Group D)
/_publishing_drafts/
/_wake_probe/

# Bench / eval / recording output dirs at root (Group D)
/bench_data_*/
/chatterbox_eval_out/
/chatterbox_eval_out_clone/
/lang_test_baseline_*/
/record/

# Top-level scratch result JSONs (Group C — explicit so survives any future
# loosening of the `/_*.json` rule above)
/vlm_behavior_*_results.json
/results_dense_*.json
/results_moe_*.json

# Binary reference material kept locally for study only (Group F)
*.pptx
*.pdf

# Operational notes that contain stale internal IPs or local-only context
# (NOTES-1 classification — keep 3 explicit; 4 others moved to docs/ subdirs)
/goal.md
/OSS_NOTES.md
/progress_2026_05_12_13.md
