{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./scripts/verify.sh)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ruff check .)",
      "Bash(ruff format .)",
      "Bash(ruff format --check .)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(python -m reachy_intent_runtime.demo *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(rm -rf *)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/task-complete-quality-gate.sh"
          }
        ]
      }
    ]
  }
}
