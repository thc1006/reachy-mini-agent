[Unit]
Description=Reachy Mini Robot Brain
After=network-online.target kokoro.service whisper.service
Wants=network-online.target

[Service]
# Patch #2 (2026-05-16): Type=notify + WatchdogSec=120s. robot_brain.py sends
# READY=1 after threads are up, then WATCHDOG=1 every 30s from the idle loop.
# If the main thread blocks or the python process deadlocks, watchdog timeout
# kicks Restart=on-failure. This complements the log-silent watchdog timer
# (commit 5daaf8f) — sd_notify catches in-process deadlocks the log watcher
# would miss (e.g. when print() keeps running but main loop is stuck).
Type=notify
TimeoutStartSec=180
WatchdogSec=120
WorkingDirectory=/home/reachym/dev/reachy-agent/robot
ExecStart=/home/reachym/dev/reachy-agent/robot/run_robot.sh
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/reachym/dev/reachy-agent/robot/logs/robot_brain.log
StandardError=inherit

[Install]
WantedBy=default.target
