[Unit]
Description=whisper.cpp server (large-v3-turbo · GB10 CUDA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/whisper.cpp
ExecStart=%h/whisper.cpp/build/bin/whisper-server \
    -m %h/whisper.cpp/models/ggml-large-v3-turbo.bin \
    --host 127.0.0.1 --port 8881 \
    -t 8 --convert
Restart=on-failure
RestartSec=3
StandardOutput=append:%h/logs/whisper-server.log
StandardError=append:%h/logs/whisper-server.log

[Install]
WantedBy=default.target
